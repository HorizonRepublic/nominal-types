exports[`JSON Schema of every built-in > DecimalString stays as it is > JSON Schema 1`] = `
{
  "input draft-07": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "description": "a decimal number as text",
    "examples": [
      "12.34",
      "-0.5",
    ],
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
    "title": "nominal.DecimalString",
    "type": "string",
  },
  "input draft-2020-12": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
