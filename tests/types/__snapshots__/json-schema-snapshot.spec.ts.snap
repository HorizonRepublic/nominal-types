        "title": "nominal.Uuid",
        "type": "string",
      },
      "note": {
        "anyOf": [
          {
            "description": "an email address",
            "examples": [
              "jane.doe@example.com",
            ],
            "format": "email",
            "maxLength": 254,
            "minLength": 6,
            "not": {
              "pattern": "^[^@]{65}",
