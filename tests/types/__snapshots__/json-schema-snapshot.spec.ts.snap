exports[`JSON Schema of every built-in > DomainName stays as it is > JSON Schema 1`] = `
{
  "input draft-07": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "allOf": [
      {
        "description": "a host name",
        "format": "hostname",
        "maxLength": 253,
        "minLength": 1,
        "not": {
