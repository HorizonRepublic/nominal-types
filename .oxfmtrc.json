{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "proseWrap": "preserve",
  "sortImports": {
    "groups": ["builtin", "external", ["parent", "sibling", "index"], "unknown"]
  },
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ],
  "ignorePatterns": ["node_modules/", "dist/", "coverage/", "CHANGELOG.md"]
}
