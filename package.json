{
  "name": "@horizon-republic/nominal-types",
  "version": "3.0.0",
  "description": "Nominal types with runtime validation",
  "keywords": [
    "branded-types",
    "nominal-types",
    "typescript",
    "validation",
    "value-objects"
  ],
  "homepage": "https://github.com/HorizonRepublic/nominal-types#readme",
  "bugs": "https://github.com/HorizonRepublic/nominal-types/issues",
  "license": "MIT",
  "author": "Kyrylo Lytvynov <themaiby0@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HorizonRepublic/nominal-types.git"
  },
  "files": [
    "dist",
    "docs",
    "llms.txt"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "temporal": [
        "./dist/temporal/index.d.cts"
      ],
      "testing": [
        "./dist/testing/index.d.cts"
      ],
      "adapters/*": [
        "./dist/adapters/*/index.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "module": "./dist/index.js",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": "./dist/index.cjs"
    },
    "./temporal": {
      "module": "./dist/temporal/index.js",
      "import": {
        "types": "./dist/temporal/index.d.ts",
        "default": "./dist/node/temporal/index.js"
      },
      "require": "./dist/temporal/index.cjs"
    },
    "./testing": {
      "module": "./dist/testing/index.js",
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/node/testing/index.js"
      },
      "require": "./dist/testing/index.cjs"
    },
    "./adapters/nest": {
      "module": "./dist/adapters/nest/index.js",
      "import": {
        "types": "./dist/adapters/nest/index.d.ts",
        "default": "./dist/node/adapters/nest/index.js"
      },
      "require": "./dist/adapters/nest/index.cjs"
    },
    "./adapters/class-validator": {
      "module": "./dist/adapters/class-validator/index.js",
      "import": {
        "types": "./dist/adapters/class-validator/index.d.ts",
        "default": "./dist/node/adapters/class-validator/index.js"
      },
      "require": "./dist/adapters/class-validator/index.cjs"
    },
    "./adapters/swagger": {
      "module": "./dist/adapters/swagger/index.js",
      "import": {
        "types": "./dist/adapters/swagger/index.d.ts",
        "default": "./dist/node/adapters/swagger/index.js"
      },
      "require": "./dist/adapters/swagger/index.cjs"
    },
    "./adapters/arktype": {
      "module": "./dist/adapters/arktype/index.js",
      "import": {
        "types": "./dist/adapters/arktype/index.d.ts",
        "default": "./dist/node/adapters/arktype/index.js"
      },
      "require": "./dist/adapters/arktype/index.cjs"
    },
    "./adapters/zod": {
      "module": "./dist/adapters/zod/index.js",
      "import": {
        "types": "./dist/adapters/zod/index.d.ts",
        "default": "./dist/node/adapters/zod/index.js"
      },
      "require": "./dist/adapters/zod/index.cjs"
    },
    "./adapters/valibot": {
      "module": "./dist/adapters/valibot/index.js",
      "import": {
        "types": "./dist/adapters/valibot/index.d.ts",
        "default": "./dist/node/adapters/valibot/index.js"
      },
      "require": "./dist/adapters/valibot/index.cjs"
    },
    "./adapters/mikro-orm": {
      "module": "./dist/adapters/mikro-orm/index.js",
      "import": {
        "types": "./dist/adapters/mikro-orm/index.d.ts",
        "default": "./dist/node/adapters/mikro-orm/index.js"
      },
      "require": "./dist/adapters/mikro-orm/index.cjs"
    },
    "./adapters/typeorm": {
      "module": "./dist/adapters/typeorm/index.js",
      "import": {
        "types": "./dist/adapters/typeorm/index.d.ts",
        "default": "./dist/node/adapters/typeorm/index.js"
      },
      "require": "./dist/adapters/typeorm/index.cjs"
    },
    "./adapters/drizzle": {
      "module": "./dist/adapters/drizzle/index.js",
      "import": {
        "types": "./dist/adapters/drizzle/index.d.ts",
        "default": "./dist/node/adapters/drizzle/index.js"
      },
      "require": "./dist/adapters/drizzle/index.cjs"
    },
    "./adapters/sequelize": {
      "module": "./dist/adapters/sequelize/index.js",
      "import": {
        "types": "./dist/adapters/sequelize/index.d.ts",
        "default": "./dist/node/adapters/sequelize/index.js"
      },
      "require": "./dist/adapters/sequelize/index.cjs"
    },
    "./adapters/graphql": {
      "module": "./dist/adapters/graphql/index.js",
      "import": {
        "types": "./dist/adapters/graphql/index.d.ts",
        "default": "./dist/node/adapters/graphql/index.js"
      },
      "require": "./dist/adapters/graphql/index.cjs"
    },
    "./adapters/superjson": {
      "module": "./dist/adapters/superjson/index.js",
      "import": {
        "types": "./dist/adapters/superjson/index.d.ts",
        "default": "./dist/node/adapters/superjson/index.js"
      },
      "require": "./dist/adapters/superjson/index.cjs"
    },
    "./adapters/fastify": {
      "module": "./dist/adapters/fastify/index.js",
      "import": {
        "types": "./dist/adapters/fastify/index.d.ts",
        "default": "./dist/node/adapters/fastify/index.js"
      },
      "require": "./dist/adapters/fastify/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests && tsc --noEmit -p tools/throws-check",
    "lint": "oxlint --ignore-pattern 'bench/**' && npm run -s check:throws",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:dist": "node tests/built-package.mjs",
    "test:size": "node tests/bundle-size.mjs",
    "bench:typia": "ttsc -p bench/typia/tsconfig.json",
    "bench": "npm run bench:check && node bench/run.ts",
    "bench:check": "npm run build && npm run bench:typia && oxlint bench && tsc --noEmit -p bench && tsc -p bench/nest/tsconfig.json && node bench/verify.ts",
    "bench:document": "npm run bench:check && node bench/document/run.ts",
    "bench:nest": "npm run bench:check && node bench/nest/run.ts",
    "profile:cpu": "node bench/profile/cpu.ts",
    "profile:deopt": "node bench/profile/deopt.ts",
    "check:throws": "node --experimental-strip-types --disable-warning=ExperimentalWarning tools/throws-check/cli.ts --project tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@fastify/swagger": "^9.9.1",
    "@hono/standard-validator": "^0.4.0",
    "@mikro-orm/core": "^7.2.4",
    "@mikro-orm/sqlite": "^7.2.4",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/microservices": "^12.1.2",
