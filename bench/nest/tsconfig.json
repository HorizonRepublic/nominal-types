{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "./dist"
  },
  "include": ["./*.ts", "../document/data.ts"],
  "exclude": ["./run.ts"]
}
