exports[`JSON Schema of every built-in > n.object stays as it is > JSON Schema 1`] = `
{
  "input draft-07": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "properties": {
      "age": {
        "description": "a positive integer",
        "maximum": 9007199254740991,
        "minimum": 1,
        "title": "nominal.PositiveInteger",
        "type": "integer",
      },
      "email": {
        "description": "an email address",
        "examples": [
          "jane.doe@example.com",
        ],
        "format": "email",
        "maxLength": 254,
        "minLength": 6,
        "not": {
          "pattern": "^[^@]{65}",
        },
        "pattern": "^[A-Za-z0-9!#$%&'*+/=?^_\`{|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_\`{|}~-]+)*@(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:[A-Za-z]{2,63}|xn--[A-Za-z0-9-]{1,59})$",
        "title": "nominal.Email",
        "type": "string",
      },
      "id": {
        "description": "a UUID",
        "examples": [
          "0190f1c2-3b4a-7c5d-8e9f-0a1b2c3d4e5f",
