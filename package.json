    "@nestjs/swagger": "^12.0.2",
    "@nestjs/testing": "^12.1.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@standard-schema/spec": "^1.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@trpc/server": "^11.19.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "arktype": "^2.2.7",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.3",
    "effect": "^4.0.1",
    "elysia": "^1.4.30",
    "esbuild": "^0.28.2",
    "eslint-plugin-jsdoc": "^65.2.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "fast-check": "^4.10.2",
    "fastify": "^5.12.5",
    "graphql": "^17.0.2",
    "hono": "^4.13.13",
    "joi": "^18.2.9",
    "mitata": "^1.0.34",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.25",
    "reflect-metadata": "^0.2.2",
    "rollup": "^4.64.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.8",
    "superjson": "^2.2.6",
    "sury": "^11.1.0-rc.0",
    "temporal-polyfill": "^1.0.5",
    "tsdown": "^0.23.0",
    "ttsc": "^0.30.4",
    "typebox": "^1.3.36",
    "typeorm": "^1.1.1",
    "typescript": "^7.0.2",
    "typia": "^15.1.0",
    "valibot": "^1.5.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@mikro-orm/core": "^7.0.0",
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/swagger": "^11.0.0 || ^12.0.0",
    "arktype": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0 || ^0.15.0",
    "fast-check": "^4.6.0",
    "fastify": "^5.0.0",
    "graphql": "^16.0.0 || ^17.0.0",
    "rxjs": "^7.2.0",
    "sequelize": "^6.0.0",
